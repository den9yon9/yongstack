DATABASE_URL=postgres://nestup:nestup@localhost:5432/nestup
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-this-with-a-random-32-char-secret

# Logging (debug | info | warn | error | silent)
LOG_LEVEL=info

# CORS origin: `*` (any), single origin `https://app.example.com`,
# or comma-separated allowlist `https://a.com,https://b.com`
CORS_ORIGIN=*

# Trust proxy for rate-limiter IP extraction (true | false)
TRUST_PROXY=false

# 无请求语言线索时的回退语言 (en | zh-CN); 请求可经 Accept-Language 或 X-Locale/?lang= 覆盖
DEFAULT_LOCALE=en

# API ports
STOREFRONT_PORT=3000
ADMIN_PORT=3001

# 认证限流(次/分钟), 后续登录/注册接口使用
AUTH_RATE_LIMIT_PER_MINUTE=20

# 可选: worker 健康检查 HTTP 端口(设置后暴露 /health + /metrics)
HEALTH_PORT=3100

# Testing 流程基建（跑 pnpm test 需要；getTestEnv() fail-fast 读取）
TESTING_DATABASE_URL=postgres://nestup:nestup@localhost:5432/nestup_test
TESTING_REDIS_URL=redis://localhost:6379/1
TESTING_SESSION_SECRET=test-session-secret-0123456789abcdef

# --- 对象存储 (S3 兼容) ---
# 本地: SeaweedFS `docker compose -f docker/docker-compose.yml up -d seaweedfs`
# 生产: Cloudflare R2 / 腾讯云 COS 等 S3 兼容服务
# R2: STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com / STORAGE_REGION=auto / STORAGE_FORCE_PATH_STYLE=false
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_REGION=us-east-1
STORAGE_BUCKET=nestup
STORAGE_ACCESS_KEY_ID=admin
STORAGE_SECRET_ACCESS_KEY=secret
STORAGE_FORCE_PATH_STYLE=true
# 图片等公开资源访问前缀; 绑定自有域名时改这里
STORAGE_PUBLIC_BASE_URL=http://localhost:8333/nestup
STORAGE_KEY_PREFIX=media
