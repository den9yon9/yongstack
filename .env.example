DATABASE_URL=postgres://yongstack:yongstack@localhost:5432/yongstack
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-this-with-a-random-32-char-secret

# Logging (debug | info | warn | error | silent)
LOG_LEVEL=info

# CORS origin: `*` (any), single origin `https://app.example.com`,
# or comma-separated allowlist `https://a.com,https://b.com`
CORS_ORIGIN=*

# Trust proxy for rate-limiter IP extraction (true | false)
TRUST_PROXY=false

# 无请求语言线索时的回退语言 (en | zh-CN); 请求可经 Accept-Language 或 X-Locale/?lang= 覆盖
DEFAULT_LOCALE=en

# API ports
APP_PORT=3000
ADMIN_PORT=3001

# 管理员 seed(bootstrap 会据此创建/更新 admin 账号; 生产必须显式设置强密码 >= 12 位)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456

# 认证限流(次/分钟), 后续登录/注册接口使用
AUTH_RATE_LIMIT_PER_MINUTE=20

# --- 手机号验证码登录 ---
# 当前仅 console(只打日志); 生产需接入真实 SMS Provider
SMS_PROVIDER=console
SMS_SIGN_NAME=Yongstack
# 验证码 HMAC 密钥; 未设置时回退 SESSION_SECRET
# PHONE_CODE_SECRET=replace-this-with-a-random-32-char-secret
# 仅开发/测试: 固定 6 位验证码, 便于 e2e; 生产启动会拒绝
# SMS_DEV_CODE=123456

# 可选: worker 健康检查 HTTP 端口(设置后暴露 /health + /metrics)
HEALTH_PORT=3100

# --- 邮件 (worker 消费 email 队列; console 只打日志, 开发默认) ---
# console | smtp; smtp 模式下 SMTP_HOST/SMTP_PORT/MAIL_FROM 必填
MAIL_TRANSPORT=console
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=no-reply@example.com
# SMTP_PASS=your-smtp-password
# MAIL_FROM=Yongstack <no-reply@example.com>
# 邮件/通知中的前端链接
APP_WEB_URL=http://localhost:5173

# outbox 轮询间隔(ms)与单批数量
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=20

# 软删文件的存储清理轮询间隔(ms)与软删后保留时长(ms); 未配置 STORAGE_* 时不启动
FILE_CLEANUP_INTERVAL_MS=60000
FILE_CLEANUP_MIN_AGE_MS=3600000

# Testing 流程基建（跑 pnpm test 需要；getTestEnv() fail-fast 读取）
TESTING_DATABASE_URL=postgres://yongstack:yongstack@localhost:5432/yongstack_test
TESTING_REDIS_URL=redis://localhost:6379/1
TESTING_SESSION_SECRET=test-session-secret-0123456789abcdef

# --- 对象存储 (S3 兼容) ---
# 本地: SeaweedFS `docker compose -f docker/docker-compose.yml up -d seaweedfs`
# 生产: Cloudflare R2 / 腾讯云 COS 等 S3 兼容服务
# R2: STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com / STORAGE_REGION=auto / STORAGE_FORCE_PATH_STYLE=false
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_REGION=us-east-1
STORAGE_BUCKET=yongstack
STORAGE_ACCESS_KEY_ID=admin
STORAGE_SECRET_ACCESS_KEY=secret
STORAGE_FORCE_PATH_STYLE=true
# 图片等公开资源访问前缀; 绑定自有域名时改这里
STORAGE_PUBLIC_BASE_URL=http://localhost:8333/yongstack
STORAGE_KEY_PREFIX=media
