{
  "name": "@nestup/database",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:generate": "bun --env-file=../../.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "bun --env-file=../../.env node_modules/drizzle-kit/bin.cjs migrate",
    "migrate": "bun --env-file=../../.env src/migrate.ts",
    "test": "bun --env-file=../../.env test --parallel=1"
  },
  "dependencies": {
    "@nestup/shared": "workspace:*",
    "@sinclair/typebox": "^0.34.0",
    "drizzle-orm": "^0.40.0",
    "drizzle-typebox": "^0.3.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.0"
  }
}
