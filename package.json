{
  "name": "yongstack",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap": "bun scripts/dev-bootstrap.ts",
    "bootstrap:check": "bun scripts/dev-bootstrap.ts --check-only",
    "bootstrap:reset": "bun scripts/dev-bootstrap.ts --reset",
    "build": "turbo build",
    "check": "eslint . && prettier --check .",
    "clean": "rm -rf apps/*/dist packages/*/dist domains/*/dist usecases/*/dist apps/*/.turbo packages/*/.turbo domains/*/.turbo usecases/*/.turbo",
    "db:backup": "bun scripts/db-backup.ts",
    "db:rbac-sync": "bun --env-file=.env scripts/seed.ts --rbac-only",
    "db:restore": "bun scripts/db-restore.ts",
    "db:seed": "bun --env-file=.env scripts/seed.ts",
    "dev": "turbo migrate && turbo dev",
    "e2e": "turbo run e2e",
    "format": "prettier --write .",
    "gen": "bun scripts/gen-domain.ts",
    "i18n:check": "bun scripts/i18n-extract.ts --check",
    "i18n:extract": "bun scripts/i18n-extract.ts",
    "knip": "bun --env-file=.env.example node_modules/knip/bin/knip.js",
    "lint": "eslint .",
    "prepare": "lefthook install",
    "prod:down": "docker compose --env-file .env.production -f docker/docker-compose.prod.yml down",
    "prod:logs": "docker compose --env-file .env.production -f docker/docker-compose.prod.yml logs -f",
    "prod:observability": "docker compose --env-file .env.production -f docker/docker-compose.prod.yml --profile observability up -d",
    "prod:up": "docker compose --env-file .env.production -f docker/docker-compose.prod.yml up -d",
    "storage:init": "bun scripts/storage-init.ts",
    "test": "turbo test --concurrency=1",
    "typecheck": "turbo typecheck && tsc -p scripts/tsconfig.json"
  },
  "dependencies": {
    "@yongstack/database": "workspace:*",
    "@yongstack/rbac": "workspace:*",
    "@yongstack/shared": "workspace:*"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^10.0.1",
    "@sinclair/typebox": "^0.34.0",
    "@types/bun": "^1.2.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "knip": "^6.44.2",
    "lefthook": "^1.11.0",
    "prettier": "^3.9.6",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "bun": ">=1.2"
  }
}
