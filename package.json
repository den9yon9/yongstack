{
  "name": "yongstack",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo migrate && turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck && tsc -p scripts/tsconfig.json",
    "test": "turbo test --concurrency=1",
    "e2e": "turbo run e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "eslint . && prettier --check .",
    "clean": "rm -rf apps/*/dist packages/*/dist domains/*/dist usecases/*/dist apps/*/.turbo packages/*/.turbo domains/*/.turbo usecases/*/.turbo",
    "bootstrap": "bun scripts/dev-bootstrap.ts",
    "bootstrap:reset": "bun scripts/dev-bootstrap.ts --reset",
    "bootstrap:check": "bun scripts/dev-bootstrap.ts --check-only",
    "db:seed": "bun --env-file=.env scripts/seed.ts",
    "gen": "bun scripts/gen-domain.ts",
    "storage:init": "bun scripts/storage-init.ts",
    "i18n:extract": "bun scripts/i18n-extract.ts",
    "i18n:check": "bun scripts/i18n-extract.ts --check",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@sinclair/typebox": "^0.34.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.2.0",
    "@yongstack/database": "workspace:*",
    "@yongstack/rbac": "workspace:*",
    "@yongstack/shared": "workspace:*",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "drizzle-orm": "^0.40.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "lefthook": "^1.11.0",
    "prettier": "^3.9.6",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "bun": ">=1.2"
  }
}
