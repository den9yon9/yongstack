# 单机生产 compose 环境样例。复制为 .env.production 后修改。
# 注意: DATABASE_URL/REDIS_URL 的主机名必须是 compose 服务名(postgres/redis), 不是 localhost。
NODE_ENV=production
LOG_LEVEL=info

DATABASE_URL=postgres://yongstack:change-me@postgres:5432/yongstack
REDIS_URL=redis://redis:6379
POSTGRES_USER=yongstack
POSTGRES_PASSWORD=change-me
POSTGRES_DB=yongstack

SESSION_SECRET=replace-with-a-random-32-char-secret
DEFAULT_LOCALE=zh-CN
CORS_ORIGIN=https://app.example.com,https://admin.example.com
TRUST_PROXY=true

APP_PORT=3000
ADMIN_PORT=3001
APP_DOMAIN=app.example.com
ADMIN_DOMAIN=admin.example.com
ACME_EMAIL=ops@example.com

AUTH_RATE_LIMIT_PER_MINUTE=20
API_RATE_LIMIT_PER_MINUTE=120

MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=no-reply@example.com
SMTP_PASS=change-me
MAIL_FROM=Yongstack <no-reply@example.com>
APP_WEB_URL=https://app.example.com

SMS_PROVIDER=console
SMS_SIGN_NAME=Yongstack

OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=20
FILE_CLEANUP_INTERVAL_MS=60000
FILE_CLEANUP_MIN_AGE_MS=3600000
FILE_PENDING_MAX_AGE_MS=86400000

RETENTION_OUTBOX_DELIVERED_DAYS=30
RETENTION_OUTBOX_FAILED_DAYS=90
RETENTION_TOKEN_DAYS=7
RETENTION_AUDIT_DAYS=365
RETENTION_IDEMPOTENCY_DAYS=7

# SENTRY_DSN=https://<key>@sentry.io/<project>
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=git-sha

BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# 可选观测栈 (--profile observability); Grafana 仅绑定 127.0.0.1:3005
GRAFANA_ADMIN_PASSWORD=change-me

# 对象存储: 生产建议 R2/COS, 不要用本地 SeaweedFS
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=yongstack
STORAGE_ACCESS_KEY_ID=change-me
STORAGE_SECRET_ACCESS_KEY=change-me
STORAGE_FORCE_PATH_STYLE=false
STORAGE_PUBLIC_BASE_URL=https://media.example.com
STORAGE_KEY_PREFIX=media
# 浏览器预签名直传的允许来源(逗号分隔); 生产填前端域名
# STORAGE_CORS_ORIGINS=https://app.example.com,https://admin.example.com

# 可选: 手动 seed 管理员
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-at-least-12-chars
